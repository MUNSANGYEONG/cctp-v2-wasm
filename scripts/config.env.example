# ─────────────────────────────────────────────────────────────────────────────
# cctp-v2 forwarder-factory 배포/업그레이드 설정
#
# 사용법:
#   cp scripts/config.env.example scripts/config.env
#   # 값 채운 뒤
#   scripts/deploy.sh
#
# scripts/config.env 은 .gitignore 에 등록되어 커밋되지 않습니다(키/노드 정보 보호).
# 모든 스크립트는 scripts/config.env 를 source 합니다(CONFIG_FILE 로 경로 override 가능).
# ─────────────────────────────────────────────────────────────────────────────

# 체인 바이너리 (wasmd, injectived, neutrond, osmosisd ...)
BINARY=injectived

# 체인 / 노드
CHAIN_ID=injective-888
NODE=https://testnet.sentry.tm.injective.network:443

# 키링
KEYRING_BACKEND=test
# 트랜잭션 서명 키 이름 (= 배포자, 기본 factory owner/admin)
KEY=deploy-test

# 가스
GAS_PRICES=160000000inj
GAS_ADJUSTMENT=1.5

# ── Factory instantiate 설정 ──────────────────────────────────────────────────
# OWNER, ADMIN 비우면 KEY 주소로 자동 설정됩니다.
OWNER=
ADMIN=
SKIP_RELAYER_ADDR=
SKIP_ENTRYPOINT_ADDR=

# ── wasm 산출물 경로 (기본: artifacts/) ──────────────────────────────────────
# FORWARDER_WASM=artifacts/forwarder.wasm
# FACTORY_WASM=artifacts/forwarder_factory.wasm
