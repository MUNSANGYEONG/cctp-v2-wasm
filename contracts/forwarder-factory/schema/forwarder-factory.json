{
  "contract_name": "forwarder-factory",
  "contract_version": "0.1.0",
  "idl_version": "1.0.0",
  "instantiate": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "InstantiateMsg",
    "type": "object",
    "required": [
      "forwarder_code_id",
      "refund_addr",
      "skip_entrypoint_addr",
      "skip_relayer_addr"
    ],
    "properties": {
      "forwarder_code_id": {
        "description": "code_id of the uploaded forwarder contract used for instantiate2.",
        "type": "integer",
        "format": "uint64",
        "minimum": 0.0
      },
      "owner": {
        "description": "Defaults to the instantiating sender when omitted.",
        "type": [
          "string",
          "null"
        ]
      },
      "refund_addr": {
        "type": "string"
      },
      "skip_entrypoint_addr": {
        "type": "string"
      },
      "skip_relayer_addr": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "execute": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ExecuteMsg",
    "oneOf": [
      {
        "description": "Deterministically create a forwarder for a (sender, dest_chain, recipient) route. Owner-only. Idempotent-guarded by the route salt.",
        "type": "object",
        "required": [
          "create_forwarder"
        ],
        "properties": {
          "create_forwarder": {
            "type": "object",
            "required": [
              "dest_chain",
              "recipient_addr",
              "sender_addr"
            ],
            "properties": {
              "dest_chain": {
                "type": "string"
              },
              "recipient_addr": {
                "type": "string"
              },
              "sender_addr": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Update shared config. Owner-only. Changing `forwarder_code_id` changes the predicted address of *future* forwarders (existing ones are unaffected).",
        "type": "object",
        "required": [
          "update_config"
        ],
        "properties": {
          "update_config": {
            "type": "object",
            "properties": {
              "forwarder_code_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint64",
                "minimum": 0.0
              },
              "owner": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "refund_addr": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "skip_entrypoint_addr": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "skip_relayer_addr": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    ]
  },
  "query": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "QueryMsg",
    "description": "Factory query interface. Re-exported by the factory crate as its `QueryMsg`, and used by the forwarder to read shared config from its parent factory.",
    "oneOf": [
      {
        "description": "Shared configuration applied to every forwarder this factory created.",
        "type": "object",
        "required": [
          "config"
        ],
        "properties": {
          "config": {
            "type": "object",
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Deterministically predicted address for a (sender, dest_chain, recipient) route, regardless of whether the forwarder has been instantiated yet.",
        "type": "object",
        "required": [
          "forwarder_address"
        ],
        "properties": {
          "forwarder_address": {
            "type": "object",
            "required": [
              "dest_chain",
              "recipient_addr",
              "sender_addr"
            ],
            "properties": {
              "dest_chain": {
                "type": "string"
              },
              "recipient_addr": {
                "type": "string"
              },
              "sender_addr": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      {
        "description": "Paginated list of forwarders already created by this factory.",
        "type": "object",
        "required": [
          "forwarders"
        ],
        "properties": {
          "forwarders": {
            "type": "object",
            "properties": {
              "limit": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "uint32",
                "minimum": 0.0
              },
              "start_after": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    ]
  },
  "migrate": null,
  "sudo": null,
  "responses": {
    "config": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FactoryConfigResponse",
      "description": "Shared config every forwarder reads from the factory at runtime.",
      "type": "object",
      "required": [
        "forwarder_code_id",
        "owner",
        "refund_addr",
        "skip_entrypoint_addr",
        "skip_relayer_addr"
      ],
      "properties": {
        "forwarder_code_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "owner": {
          "type": "string"
        },
        "refund_addr": {
          "type": "string"
        },
        "skip_entrypoint_addr": {
          "type": "string"
        },
        "skip_relayer_addr": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "forwarder_address": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ForwarderAddressResponse",
      "type": "object",
      "required": [
        "address",
        "exists"
      ],
      "properties": {
        "address": {
          "description": "Bech32 address derived via instantiate2 (deterministic).",
          "type": "string"
        },
        "exists": {
          "description": "Whether a forwarder has actually been instantiated at `address`.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "forwarders": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ForwardersResponse",
      "type": "object",
      "required": [
        "forwarders"
      ],
      "properties": {
        "forwarders": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ForwarderInfo"
          }
        }
      },
      "additionalProperties": false,
      "definitions": {
        "ForwarderInfo": {
          "type": "object",
          "required": [
            "address",
            "created_height",
            "dest_chain",
            "recipient_addr",
            "sender_addr"
          ],
          "properties": {
            "address": {
              "type": "string"
            },
            "created_height": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "dest_chain": {
              "type": "string"
            },
            "recipient_addr": {
              "type": "string"
            },
            "sender_addr": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
