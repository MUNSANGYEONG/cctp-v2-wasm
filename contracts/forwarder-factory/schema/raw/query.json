{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QueryMsg",
  "description": "Factory query interface. Re-exported by the factory crate as its `QueryMsg`, and used by the forwarder to read shared config from its parent factory.",
  "oneOf": [
    {
      "description": "Shared configuration applied to every forwarder this factory created.",
      "type": "object",
      "required": [
        "config"
      ],
      "properties": {
        "config": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Deterministically predicted address for a (sender, dest_chain, recipient) route, regardless of whether the forwarder has been instantiated yet.",
      "type": "object",
      "required": [
        "forwarder_address"
      ],
      "properties": {
        "forwarder_address": {
          "type": "object",
          "required": [
            "dest_chain",
            "recipient_addr",
            "sender_addr"
          ],
          "properties": {
            "dest_chain": {
              "type": "string"
            },
            "recipient_addr": {
              "type": "string"
            },
            "sender_addr": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Paginated list of forwarders already created by this factory.",
      "type": "object",
      "required": [
        "forwarders"
      ],
      "properties": {
        "forwarders": {
          "type": "object",
          "properties": {
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0.0
            },
            "start_after": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
