{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FactoryConfigResponse",
  "description": "Shared config every forwarder reads from the factory at runtime.",
  "type": "object",
  "required": [
    "forwarder_code_id",
    "owner",
    "refund_addr",
    "skip_entrypoint_addr",
    "skip_relayer_addr"
  ],
  "properties": {
    "forwarder_code_id": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "owner": {
      "type": "string"
    },
    "refund_addr": {
      "type": "string"
    },
    "skip_entrypoint_addr": {
      "type": "string"
    },
    "skip_relayer_addr": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
