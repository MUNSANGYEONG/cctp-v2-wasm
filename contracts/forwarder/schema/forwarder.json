      ],
      "properties": {
        "requests": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RequestItem"
          }
        }
      },
      "additionalProperties": false,
      "definitions": {
        "Coin": {
          "type": "object",
          "required": [
            "amount",
            "denom"
          ],
          "properties": {
            "amount": {
              "$ref": "#/definitions/Uint128"
            },
            "denom": {
              "type": "string"
            }
          }
        },
        "RequestItem": {
          "type": "object",
          "required": [
            "destination_channel",
            "id",
