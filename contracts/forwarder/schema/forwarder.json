            "id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "mint_tx_hash": {
              "type": "string"
            },
            "source_tx_height": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "source_tx_index": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0.0
            },
            "status": {
              "$ref": "#/definitions/RequestStatus"
            },
            "transfer_coin": {
              "$ref": "#/definitions/Coin"
