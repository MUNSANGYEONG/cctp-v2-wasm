          "type": "string"
        },
        "factory": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "recipient_addr": {
          "type": "string"
        },
        "refund_addr": {
          "type": "string"
        },
        "sender_addr": {
          "type": "string"
        },
        "skip_entrypoint_addr": {
          "type": "string"
        },
        "skip_relayer_addr": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "request_by_mint_tx_hash": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "RequestResponse",
      "type": "object",
      "required": [
        "request"
      ],
      "properties": {
