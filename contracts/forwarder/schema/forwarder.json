      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ConfigResponse",
      "description": "Merged view: local route fields + shared config resolved from the factory.",
      "type": "object",
      "required": [
        "dest_chain",
        "factory",
        "owner",
        "recipient_addr",
        "refund_addr",
        "sender_addr",
        "skip_entrypoint_addr",
        "skip_relayer_addr"
